RewriteEngine On

# Serve existing files/directories as-is
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# /admin (no slash) → /admin/ so relative admin links resolve correctly
RewriteRule ^admin$ admin/ [R=301,L]

# Optional clean-ish fallbacks
RewriteRule ^about/?$ about.php [L]
RewriteRule ^recent-projects/?$ recent-projects.php [L]
RewriteRule ^courses/?$ courses.php [L]
RewriteRule ^originals/?$ purchase/originals/ [R=301,L]
RewriteRule ^prints/?$ purchase/prints/ [R=301,L]
RewriteRule ^purchase/?$ purchase/originals/ [R=301,L]
RewriteRule ^contact/?$ contact.php [L]
RewriteRule ^product/([A-Za-z0-9_-]+)/?$ purchase/originals/product.php?id=$1 [R=301,L,QSA]
RewriteRule ^purchase/originals/product/([A-Za-z0-9_-]+)/?$ purchase/originals/product.php?id=$1 [L,QSA]
RewriteRule ^purchase/prints/product/([A-Za-z0-9_-]+)/?$ purchase/prints/product.php?id=$1 [L,QSA]
